<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Inspector" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/Inspector" prefix_auto="1" extension_auto="1" />
				<Option working_dir="rundir" />
				<Option object_output="obj/Debug/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DWL_DEBUG" />
					<Add option="-DDEBUG" />
					<Add option="-DDEBUGMODE" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/Inspector" prefix_auto="1" extension_auto="1" />
				<Option working_dir="rundir" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-DWL_RELEASE" />
					<Add option="-DNDEBUG" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-w" />
			<Add option="-std=c++17" />
			<Add option="-DBUILDING_INSPECTOR" />
			<Add option="-DWL_PLATFORM_LINUX" />
			<Add directory="../TelltaleToolLib" />
			<Add directory="../vendor/imgui" />
			<Add directory="../vendor/GLFW/include" />
			<Add directory="../Walnut/src" />
			<Add directory="../vendor/glm" />
		</Compiler>
		<Linker>
			<Add library="../TelltaleToolLib/bin/$(TARGET_NAME)/libTelltaleToolLib.a" />
			<Add library="../vendor/imgui/bin/$(TARGET_NAME)/libImGui.a" />
			<Add library="../Walnut/bin/$(TARGET_NAME)/libWalnut.a" />
			<Add library="../vendor/GLFW/bin/$(TARGET_NAME)/libGLFW.a" />
			<Add library="vulkan" />
		</Linker>
		<ExtraCommands>
			<Add after='mkdir -p &quot;$(PROJECT_DIR)/rundir/_Dev&quot;' />
			<Add after='cp -r -n -t &quot;$(PROJECT_DIR)/rundir&quot; &quot;$(PROJECT_DIR)/../Release Builds/Dist/imgui.ini&quot; &quot;$(PROJECT_DIR)/../Release Builds/Dist/Information&quot; &quot;$(PROJECT_DIR)/../Release Builds/Dist/LibBin&quot; &quot;$(PROJECT_DIR)/../Release Builds/Dist/UserSettings&quot;' />
			<Add after='cp -r -n -t &quot;$(PROJECT_DIR)/rundir/_Dev&quot; &quot;$(PROJECT_DIR)/../Release Builds/Dist/Caches&quot; &quot;$(PROJECT_DIR)/../Release Builds/Dist/Database&quot;' />
			<Mode after="always" />
		</ExtraCommands>
		<Unit filename="src/FileEditor/AnimationEditor.cpp" />
		<Unit filename="src/FileEditor/AnyTypeEditor.cpp" />
		<Unit filename="src/FileEditor/Archive2Editor.cpp" />
